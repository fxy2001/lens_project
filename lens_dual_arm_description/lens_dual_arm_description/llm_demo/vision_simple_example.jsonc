{
  // 任务编号，每次抓取建议不同，便于日志排查
  "command_id": "grab_001",

  // 使用哪只机械臂：left | right
  "arm": "right",

  // 抓取目标在机器人基座坐标系下的位置 [x, y, z]，单位：米（由视觉+手眼标定得到）
  "target": [0.48, -0.24, 0.42],

  // 整段轨迹执行时间（秒），越大动作越慢
  "duration_s": 4.0,

  // 预设动作：grasp=上→下→上（抓取）| touch | line | custom
  "action": "grasp"
}
